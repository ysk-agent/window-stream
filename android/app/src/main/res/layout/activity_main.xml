<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Window Stream — Android diagnostics"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/nativeVersionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Rust core: (not loaded)"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/captureStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Capture: stopped"
            android:textSize="14sp" />

        <Button
            android:id="@+id/startCaptureButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Start capture (asks MediaProjection consent)" />

        <Button
            android:id="@+id/stopCaptureButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Stop capture" />

        <Button
            android:id="@+id/refreshDiagnosticsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Refresh codec diagnostics" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="MediaCodec / VP9 diagnostics"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/diagnosticsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:text="Diagnostics not run yet."
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
